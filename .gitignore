# ==========================================
# Visual Studio Code
# ==========================================
# Workspace local configuration
.vscode/*

# Optional exceptions for VS Code:
# If you work in a team and want to share recommended extensions or tasks,
# un-ignore specific workspace configuration files:
! .vscode/settings.json
! .vscode/tasks.json
! .vscode/launch.json
! .vscode/extensions.json

# VS Code workspace files
*.code-workspace

# VS Code local history
.history/